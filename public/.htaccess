# SPA fallback for Apache (e.g. SiteGround). Serves index.html for client routes
# like /journal/foo while leaving real files and directories untouched.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^sovereign-ai/?$ /controlled-intelligence [R=301,L]
  RewriteRule ^journal/2026-05-10-what-controlled-intelligence-actually-is/?$ /journal/2026-05-10-introducing-controlled-intelligence [R=301,L]
  RewriteRule ^index\.html$ - [L]
  # Prerendered journal HTML (OG/Twitter meta). Serve when present so crawlers see cover images.
  RewriteCond %{DOCUMENT_ROOT}/journal/$1/index.html -f
  RewriteRule ^journal/([^/]+)/?$ /journal/$1/index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
